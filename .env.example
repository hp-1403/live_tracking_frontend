# Frontend Environment Variables

# Backend API URL (Render backend URL + /api, or just base Render URL)
# Example: https://live-tracker-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Backend WebSocket / Socket.IO Server URL (Render backend URL without /api)
# Example: https://live-tracker-api.onrender.com
VITE_BACKEND_URL=http://localhost:5001
